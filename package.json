{
  "name": "unit-back",
  "private": true,
  "version": "1.0.0",
  "description": "Units (Tasker) NestJS API",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "lint:format": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "lint:fs": "ls-lint",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "lint:editor": "editorconfig-checker",
    "start:prod": "node dist/main",
    "lint:js": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:type": "npx tsc --noEmit",
    "lint:js:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint": "npm run lint:format && npm run lint:fs && npm run lint:js && npm run lint:type",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky install || true",
    "typeorm": "npm run build && npx typeorm -d dist/database/data-source.js",
    "schema:drop": "npm run typeorm -- schema:drop",
    "migrate:tasker-auth": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-tasker-auth-migration.ts",
    "migrate:unit-cleanup": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-unit-schema-cleanup-migration.ts",
    "migrate:user-to-unit": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-user-to-unit-rename-migration.ts",
    "migrate:drop-unit-balance": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-drop-unit-balance-migration.ts",
    "migrate:drop-reasons": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-drop-reasons-migration.ts",
    "migrate:drop-unit-points": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-drop-unit-points-migration.ts",
    "migrate:ids-to-uuid": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-ids-to-uuid-migration.ts",
    "migrate:notes": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-notes-migration.ts",
    "migrate:assessment": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-assessment-migration.ts",
    "migrate:rebaseline": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-rebaseline-migration.ts",
    "migrate:final-investigation": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-final-investigation-migration.ts",
    "migrate:passphrase-challenge-rate-limit": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-passphrase-change-challenge-rate-limit-migration.ts",
    "migrate:case-insensitive-unitname": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-case-insensitive-unitname-migration.ts",
    "migrate:security-question": "ts-node -r tsconfig-paths/register ./src/database/migrations/run-security-question-migration.ts",
    "seed:bobozak": "ts-node -r tsconfig-paths/register ./src/database/seeds/bobozak-tasks.seed.ts",
    "seed:bobozak-filter-tasks": "ts-node -r tsconfig-paths/register ./src/database/seeds/bobozak-filter-test-tasks.seed.ts"
  },
  "overrides": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.0",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "@sideway/address": "^5.0.0",
    "bcrypt": "^5.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.6",
    "date-fns": "^3.3.1",
    "joi": "^17.9.2",
    "nestjs-cloudinary": "^2.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.11.0",
    "pg-connection-string": "^2.9.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "streamifier": "^0.1.1",
    "swagger-ui-dist": "^5.29.1",
    "typeorm": "^0.3.20",
    "ua-parser-js": "^2.0.10",
    "uuid": "^10.0.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@ls-lint/ls-lint": "^2.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/streamifier": "^0.1.2",
    "@types/supertest": "^2.0.12",
    "@types/ua-parser-js": "^0.7.39",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^5.59.11",
    "@typescript-eslint/parser": "^5.59.11",
    "editorconfig-checker": "^5.1.0",
    "eslint": "^8.49.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-simple-import-sort": "^10.0.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^6.2.4",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.3.1",
    "ts-node": "^10.8.2",
    "tsconfig-paths": "^4.0.0",
    "typescript": "^5.5.3"
  }
}
